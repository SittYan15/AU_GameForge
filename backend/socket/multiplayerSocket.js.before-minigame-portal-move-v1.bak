import { verifyAccessToken } from "../middleware/authToken.js";
import { getConvertedUserForGuest } from "../models/googleAccountModel.js";
import { findGuestById, addGuestPoints } from "../models/guestModel.js";
import { findUserById, addUserPoints, setActiveSessionExpiration } from "../models/userModel.js";
import { getTopPlayers } from "../models/leaderboardModel.js";
import {
    cancelDynamicMissionForMinigame,
    checkDynamicMissionProgress,
    resumeDynamicMissionsAfterMinigame,
    scheduleDynamicMission,
    stopDynamicMissions
} from "../missions/missionManager.js";
import { checkCampusExplorationProgress, initializeCampusExploration } from "../exploration/explorationManager.js";
import {
    registerCampusQuizSocket,
    transferCampusQuizGuestProgress
} from "../quiz/quizManager.js";
import {
    checkCarRaceProgress,
    registerCarRaceSocket
} from "../racing/raceManager.js";

const players = new Map();
const activePlayerSockets = new Map();
let multiplayerIo = null;
const chatHistory = [];
const MAX_CHAT_HISTORY = 50;
const MAX_PLAYER_NAME_LENGTH = 50;
const MAX_SPEED_UNITS_PER_SECOND = 30;
const MOVEMENT_TOLERANCE = 3;
const MIN_SPAWN_SEPARATION = 3;
const VALID_ANIMATIONS = new Set(["idle", "walk", "run"]);

const RLGL_ROOM = "rlgl_minigame";
const RLGL_LOBBY_SECONDS = 15;
const RLGL_ROUND_DURATION_MS = 75_000;
const RLGL_RESULTS_DURATION_MS = 5_000;
const RLGL_REWARD_POINTS = 50;
const RLGL_WAITING_SPAWN = Object.freeze({
    x: -586.5,
    y: 0.30,
    z: -116.79
});


const RLGL_SPAWN_Y = 0.30;
const RLGL_CENTER_Z = -116.79;

// Players run from +X toward -X.
const RLGL_START_X = -593.45;
const RLGL_FINISH_X = -729.5;

// Safe space beyond the physical finish line.
// A player inside the lane can cross this area without being
// treated as out-of-bounds while the finish event is being processed.
const RLGL_FINISH_BUFFER_MIN_X = -744.0;

const RLGL_ARENA = Object.freeze({
    minX: -734.0,
    maxX: -592.0,
    minY: -2,
    maxY: 8,
    minZ: -144.8,
    maxZ: -88.8
});

// Waiting/spectator side is on the +X side of the start wall.
const RLGL_WAITING_MIN_X = -590;

const RLGL_MAX_SPEED_UNITS_PER_SECOND = 16;
const RLGL_MOVEMENT_TOLERANCE = 0.75;
const RLGL_MAX_MOVEMENT_ELAPSED_SECONDS = 0.25;
const RLGL_RED_MOVEMENT_TOLERANCE = 0.12;

const rlglState = {
    phase: "IDLE",
    isRedLight: false,
    roundId: 0,
    roundEndsAt: null
};

let rlglLightTimer = null;
let rlglRoundTimer = null;
let rlglLobbyInterval = null;
let rlglRestartTimer = null;

async function broadcastLeaderboard(io) {
    try {
        io.emit("leaderboard:updated", await getTopPlayers(5));
    } catch (error) {
        console.error("Could not refresh leaderboard:", error.message);
    }
}

function clearRlglTimers() {
    clearTimeout(rlglLightTimer);
    clearTimeout(rlglRoundTimer);
    clearTimeout(rlglRestartTimer);
    clearInterval(rlglLobbyInterval);
    rlglLightTimer = null;
    rlglRoundTimer = null;
    rlglLobbyInterval = null;
    rlglRestartTimer = null;
}

function getRlglSockets(io) {
    const socketIds = io.sockets.adapter.rooms.get(RLGL_ROOM);
    if (!socketIds) return [];
    return [...socketIds]
        .map((socketId) => io.sockets.sockets.get(socketId))
        .filter(Boolean);
}

function getRlglSpawn(
    index,
    x,
    rowDirection = 1
) {
    const columns = 9;
    const column = index % columns;
    const row = Math.floor(index / columns);

    return {
        x:
            x +
            row *
            2.5 *
            rowDirection,

        y: RLGL_SPAWN_Y,

        z:
            RLGL_CENTER_Z +
            (
                column -
                Math.floor(columns / 2)
            ) * 2.5
    };
}

function isVector3(value) {
    return value && [value.x, value.y, value.z].every(Number.isFinite);
}

function publicPlayer(player) {
    return {
        socketId: player.socketId,
        accountType: player.accountType,
        playerName: player.playerName,
        avatarKey: player.avatarKey,
        position: player.position,
        rotation: player.rotation,
        animation: player.animation
    };
}

function distance(a, b) {
    return Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z);
}

function horizontalDistance(a, b) {
    return Math.hypot(a.x - b.x, a.z - b.z);
}

function isInsideRlglArena(position) {
    return position.x >= RLGL_ARENA.minX
        && position.x <= RLGL_ARENA.maxX
        && position.y >= RLGL_ARENA.minY
        && position.y <= RLGL_ARENA.maxY
        && position.z >= RLGL_ARENA.minZ
        && position.z <= RLGL_ARENA.maxZ;
}

function isAtRlglFinish(position) {
    const insideFinishLane =
        position.y >= RLGL_ARENA.minY &&
        position.y <= RLGL_ARENA.maxY &&
        position.z >= RLGL_ARENA.minZ &&
        position.z <= RLGL_ARENA.maxZ;

    return (
        insideFinishLane &&
        position.x <= RLGL_FINISH_X &&
        position.x >= RLGL_FINISH_BUFFER_MIN_X
    );
}

function broadcastPlayerPosition(io, player) {
    io.emit("player:moved", {
        socketId: player.socketId,
        position: player.position,
        rotation: player.rotation
    });
}

function teleportRlglPlayer(io, socket, position, reason) {
    const player = players.get(socket.id);
    if (!player) return;

    player.position = { ...position };
    socket.data.lastMoveAt = Date.now();
    socket.emit("rlgl:teleport", { position: player.position, reason });
    broadcastPlayerPosition(io, player);
}

function resetRlglSocketState(socket) {
    socket.data.isPlaying = false;
    socket.data.isEliminated = false;
    socket.data.hasFinished = false;
    socket.data.rlglRedAnchor = null;
}

function setRlglIdle() {
    clearRlglTimers();
    rlglState.phase = "IDLE";
    rlglState.isRedLight = false;
    rlglState.roundEndsAt = null;
}

function ensureRlglStopsWhenEmpty(io) {
    if (getRlglSockets(io).length === 0) {
        setRlglIdle();
        return true;
    }
    return false;
}

function eliminateRlglPlayer(io, socket, reason) {
    if (
        !socket.data.isPlaying ||
        socket.data.isEliminated ||
        socket.data.hasFinished
    ) {
        return;
    }

    const player = players.get(socket.id);

    if (!player) return;

    socket.data.isEliminated = true;
    socket.data.rlglRedAnchor = null;

    // Tell the dead player about their death.
    socket.emit("rlgl:eliminated", {
        reason
    });

    // Tell EVERYONE in Red Light Green Light
    // exactly which player exploded.
    io.to(RLGL_ROOM).emit(
        "rlgl:player_eliminated",
        {
            socketId: socket.id,

            position: {
                x: player.position.x,
                y: player.position.y,
                z: player.position.z
            },

            reason
        }
    );

    checkRlglRoundStatus(io);
}

function toggleRlglLight(io) {
    if (rlglState.phase !== "ACTIVE") return;

    rlglState.isRedLight = !rlglState.isRedLight;
    const sockets = getRlglSockets(io);

    sockets.forEach((socket) => {
        const player = players.get(socket.id);
        if (!player || !socket.data.isPlaying || socket.data.isEliminated || socket.data.hasFinished) {
            socket.data.rlglRedAnchor = null;
            return;
        }
        socket.data.rlglRedAnchor = rlglState.isRedLight ? { ...player.position } : null;
    });

    io.to(RLGL_ROOM).emit("rlgl:state", rlglState.isRedLight);

    const delay = rlglState.isRedLight
        ? Math.random() * 2000 + 3000
        : Math.random() * 2000 + 2000;
    rlglLightTimer = setTimeout(() => toggleRlglLight(io), delay);
}

function endRlglRound(io) {
    if (rlglState.phase !== "ACTIVE") return;

    clearTimeout(rlglLightTimer);
    clearTimeout(rlglRoundTimer);
    rlglLightTimer = null;
    rlglRoundTimer = null;
    rlglState.phase = "FINISHED";
    rlglState.isRedLight = false;
    rlglState.roundEndsAt = null;

    getRlglSockets(io).forEach((socket) => {
        if (socket.data.isPlaying && !socket.data.isEliminated && !socket.data.hasFinished) {
            socket.data.isEliminated = true;
            socket.emit("rlgl:eliminated", { reason: "timeout" });

            const player = players.get(socket.id);

            if (player) {
                io.to(RLGL_ROOM).emit(
                    "rlgl:player_eliminated",
                    {
                        socketId: socket.id,
                        position: {
                            x: player.position.x,
                            y: player.position.y,
                            z: player.position.z
                        },
                        reason: "timeout"
                    }
                );
            }
        }
        socket.data.isPlaying = false;
        socket.data.rlglRedAnchor = null;
    });

    io.to(RLGL_ROOM).emit("rlgl:phase", "FINISHED");

    if (ensureRlglStopsWhenEmpty(io)) return;
    rlglRestartTimer = setTimeout(() => startRlglLobby(io), RLGL_RESULTS_DURATION_MS);
}

function checkRlglRoundStatus(io) {
    if (rlglState.phase !== "ACTIVE") return;

    const stillPlaying = getRlglSockets(io).some((socket) =>
        socket.data.isPlaying && !socket.data.isEliminated && !socket.data.hasFinished
    );

    if (!stillPlaying) endRlglRound(io);
}

function startRlglGame(io) {
    if (rlglState.phase !== "LOBBY") return;

    const sockets = getRlglSockets(io);
    if (sockets.length === 0) {
        setRlglIdle();
        return;
    }

    clearInterval(rlglLobbyInterval);
    rlglLobbyInterval = null;
    rlglState.phase = "ACTIVE";
    rlglState.isRedLight = false;
    rlglState.roundId += 1;
    rlglState.roundEndsAt = Date.now() + RLGL_ROUND_DURATION_MS;

    sockets.forEach((socket, index) => {
        socket.data.isPlaying = true;
        socket.data.isEliminated = false;
        socket.data.hasFinished = false;
        socket.data.rlglRedAnchor = null;
        teleportRlglPlayer(io, socket, getRlglSpawn(index, RLGL_START_X, -1), "round-start");
        socket.emit("rlgl:role", "player");
    });

    io.to(RLGL_ROOM).emit("rlgl:phase", "ACTIVE");
    io.to(RLGL_ROOM).emit("rlgl:state", false);
    io.to(RLGL_ROOM).emit("rlgl:round_started", {
        roundId: rlglState.roundId,
        endsAt: rlglState.roundEndsAt
    });

    rlglLightTimer = setTimeout(() => toggleRlglLight(io), Math.random() * 2000 + 2000);
    rlglRoundTimer = setTimeout(() => endRlglRound(io), RLGL_ROUND_DURATION_MS);
}

function startRlglLobby(io) {
    const sockets = getRlglSockets(io);
    if (sockets.length === 0) {
        setRlglIdle();
        return;
    }

    clearRlglTimers();
    rlglState.phase = "LOBBY";
    rlglState.isRedLight = false;
    rlglState.roundEndsAt = null;

    sockets.forEach((socket, index) => {
        resetRlglSocketState(socket);
        teleportRlglPlayer(io, socket, getRlglSpawn(index, RLGL_WAITING_SPAWN.x), "lobby-reset");
        socket.emit("rlgl:role", "waiting");
    });

    io.to(RLGL_ROOM).emit("rlgl:phase", "LOBBY");

    let count = RLGL_LOBBY_SECONDS;
    io.to(RLGL_ROOM).emit("rlgl:lobby_countdown", count);
    rlglLobbyInterval = setInterval(() => {
        count -= 1;
        if (count > 0) {
            io.to(RLGL_ROOM).emit("rlgl:lobby_countdown", count);
            return;
        }
        clearInterval(rlglLobbyInterval);
        rlglLobbyInterval = null;
        startRlglGame(io);
    }, 1000);
}

function findAvailableSpawn(requestedPosition) {
    const base = { ...requestedPosition };
    if ([...players.values()].every((player) => horizontalDistance(player.position, base) >= MIN_SPAWN_SEPARATION)) {
        return base;
    }

    for (let ring = 1; ring <= 10; ring += 1) {
        const radius = MIN_SPAWN_SEPARATION * ring;
        const spots = Math.max(8, ring * 8);
        for (let index = 0; index < spots; index += 1) {
            const angle = (index / spots) * Math.PI * 2;
            const candidate = {
                x: base.x + Math.cos(angle) * radius,
                y: base.y,
                z: base.z + Math.sin(angle) * radius
            };
            if ([...players.values()].every((player) => horizontalDistance(player.position, candidate) >= MIN_SPAWN_SEPARATION)) {
                return candidate;
            }
        }
    }

    return { x: base.x + MIN_SPAWN_SEPARATION * (players.size + 1), y: base.y, z: base.z };
}

export default function registerMultiplayerSocket(io) {
    multiplayerIo = io;
    io.on("connection", (socket) => {
        socket.data.lastMoveAt = Date.now();
        socket.emit("chat:history", chatHistory);

        registerCampusQuizSocket(
            io,
            socket,
            () => players.get(socket.id),
            {
                onEnter() {
                    cancelDynamicMissionForMinigame(socket);
                },

                onExit(player) {
                    resumeDynamicMissionsAfterMinigame(
                        io,
                        socket,
                        player
                    );
                },

                onTeleport(player, position, reason) {
                    player.position = { ...position };
                    socket.data.lastMoveAt = Date.now();
                    socket.emit("campusQuiz:teleport", {
                        position: player.position,
                        reason
                    });
                    broadcastPlayerPosition(io, player);
                }
            }
        );

        registerCarRaceSocket(
            io,
            socket,
            () => players.get(socket.id),
            {
                onEnter() {
                    cancelDynamicMissionForMinigame(
                        socket
                    );
                },

                onExit(player) {
                    resumeDynamicMissionsAfterMinigame(
                        io,
                        socket,
                        player
                    );
                },

                onTeleport(
                    player,
                    position,
                    reason
                ) {
                    player.position = {
                        ...position
                    };

                    socket.data.lastMoveAt =
                        Date.now();

                    socket.emit(
                        "carRace:teleport",
                        {
                            position:
                                player.position,
                            reason
                        }
                    );

                    broadcastPlayerPosition(
                        io,
                        player
                    );
                }
            }
        );

        socket.on("player:join", async (payload = {}) => {
            if (players.has(socket.id) || socket.data.joining) return;

            const accountType = payload.accountType;
            const guestSession = socket.request.session;
            const tokenIdentity = accountType === "user" ? verifyAccessToken(socket.handshake.auth?.token) : null;
            if (accountType !== "guest" && accountType !== "user") return;
            if (accountType === "guest"
                && (guestSession?.accountType !== "guest" || !Number.isSafeInteger(guestSession.guestId))) {
                socket.emit("player:joinError", "An authenticated guest session is required.");
                return;
            }
            if (accountType === "user" && !tokenIdentity) {
                socket.emit("player:joinError", "Authentication required.");
                return;
            }

            socket.data.joining = true;
            let account;
            try {
                account = accountType === "guest"
                    ? await findGuestById(guestSession.guestId)
                    : await findUserById(tokenIdentity.userId);
            } catch (error) {
                console.error("Could not verify multiplayer account:", error.message);
                socket.emit("player:joinError", "Account verification is temporarily unavailable.");
                socket.data.joining = false;
                return;
            }
            socket.data.joining = false;
            if (!account || account.convertedToUserId || !socket.connected) {
                if (socket.connected) socket.emit("player:joinError", "Player account not found.");
                return;
            }
            if (accountType === "user"
                && (!account.activeSessionId || account.activeSessionId !== tokenIdentity.sessionId
                    || !account.activeSessionExpiresAt
                    || new Date(account.activeSessionExpiresAt) <= new Date())) {
                socket.emit("auth:sessionReplaced", {
                    message: "Your account was logged in from another browser or device. Please log in again."
                });
                socket.disconnect(true);
                return;
            }

            if (accountType === "user") {
                socket.data.authUserId = tokenIdentity.userId;
                socket.data.authSessionId = tokenIdentity.sessionId;
                try {
                    await setActiveSessionExpiration(
                        tokenIdentity.userId,
                        tokenIdentity.sessionId,
                        new Date(Date.now() + 8 * 60 * 60 * 1000)
                    );
                } catch (error) {
                    console.error("Could not activate multiplayer session:", error.message);
                    socket.emit("player:joinError", "Session verification is temporarily unavailable.");
                    socket.disconnect(true);
                    return;
                }
                socket.data.sessionValidationTimer = setInterval(async () => {
                    try {
                        const currentUser = await findUserById(tokenIdentity.userId);
                        if (currentUser?.activeSessionId === tokenIdentity.sessionId
                            && currentUser.activeSessionExpiresAt
                            && new Date(currentUser.activeSessionExpiresAt) > new Date()) return;
                        socket.emit("auth:sessionReplaced", {
                            message: "Your account was logged in from another browser or device. Please log in again."
                        });
                        socket.disconnect(true);
                    } catch (error) {
                        console.error("Could not revalidate multiplayer session:", error.message);
                    }
                }, 5000);
            }

            const accountKey = accountType === "user"
                ? `user:${account.id}`
                : `guest:${account.id}`;
            const gameTabId = typeof socket.handshake.auth?.gameTabId === "string"
                ? socket.handshake.auth.gameTabId.slice(0, 100)
                : null;
            let existingSocketId = activePlayerSockets.get(accountKey);
            if (existingSocketId && existingSocketId !== socket.id) {
                let existingSocket = io.sockets.sockets.get(existingSocketId);
                if (gameTabId && existingSocket?.data.gameTabId === gameTabId) {
                    // During refresh, the new transport can reach player:join
                    // just before the old transport's disconnect is processed.
                    await new Promise((resolve) => setTimeout(resolve, 400));
                    existingSocketId = activePlayerSockets.get(accountKey);
                    existingSocket = existingSocketId
                        ? io.sockets.sockets.get(existingSocketId)
                        : null;
                }
                if (existingSocket?.connected) {
                    socket.emit("game:duplicateTab", {
                        message: "This game is already open in another tab. Please use the existing tab."
                    });
                    socket.disconnect(true);
                    return;
                }
                activePlayerSockets.delete(accountKey);
            }
            activePlayerSockets.set(accountKey, socket.id);
            socket.data.accountKey = accountKey;
            socket.data.gameTabId = gameTabId;

            const requestedPosition = isVector3(payload.position) ? payload.position : { x: -100, y: 10, z: 0 };
            const position = findAvailableSpawn(requestedPosition);
            const rotation = isVector3(payload.rotation) ? payload.rotation : { x: 0, y: 0, z: 0 };
            const player = {
                socketId: socket.id,
                accountType,
                userId: accountType === "user" ? account.id : null,
                guestId: accountType === "guest" ? account.id : null,
                guestCode: accountType === "guest" ? account.guestCode : null,
                playerName: account.playerName.slice(0, MAX_PLAYER_NAME_LENGTH),
                avatarKey: account.avatarKey || "default_avatar",
                position,
                rotation,
                animation: "idle"
            };

            socket.emit("players:current", [...players.values()].map(publicPlayer));
            players.set(socket.id, player);
            socket.emit("player:spawned", position);
            io.emit("player:joined", publicPlayer(player));

            try {
                const exploration = await initializeCampusExploration(socket, player);
                if (exploration.completed) scheduleDynamicMission(io, socket, player);
            } catch (error) {
                console.error("Could not initialize campus exploration:", error.message);
                socket.data.explorationCompleted = false;
                socket.emit("exploration:error", "Campus exploration progress is temporarily unavailable.");
            }
        });

        socket.on("player:move", (payload = {}) => {
            const player = players.get(socket.id);
            if (!player || !isVector3(payload.position) || !isVector3(payload.rotation)) return;

            const now = Date.now();
            const elapsedSeconds = Math.max((now - socket.data.lastMoveAt) / 1000, 1 / 60);

            if (socket.data.inRlgl) {
                const rlglElapsed = Math.min(elapsedSeconds, RLGL_MAX_MOVEMENT_ELAPSED_SECONDS);
                const rlglAllowedDistance = RLGL_MAX_SPEED_UNITS_PER_SECOND * rlglElapsed + RLGL_MOVEMENT_TOLERANCE;
                if (distance(player.position, payload.position) > rlglAllowedDistance) {
                    socket.data.lastMoveAt = now;
                    socket.emit("rlgl:correction", player.position);
                    return;
                }

                const isSpectator =
                    rlglState.phase === "ACTIVE" &&
                    !socket.data.isPlaying;

                // While waiting for the next round, players may move freely
                // AROUND the playground, but not inside the live game field.
                if (
                    rlglState.phase === "LOBBY" &&
                    isInsideRlglArena(
                        payload.position
                    )
                ) {
                    socket.data.lastMoveAt = now;
                    socket.emit(
                        "rlgl:correction",
                        player.position
                    );
                    return;
                }

                // Only finished-round players and ACTIVE spectators must
                // remain behind the starting wall.
                const mustStayBehindWall =
                    rlglState.phase === "FINISHED" ||
                    isSpectator;

                if (
                    mustStayBehindWall &&
                    payload.position.x < RLGL_WAITING_MIN_X
                ) {
                    socket.data.lastMoveAt = now;
                    socket.emit("rlgl:correction", player.position);
                    return;
                }

                if (rlglState.phase === "ACTIVE" && socket.data.isPlaying
                    && !socket.data.isEliminated && !socket.data.hasFinished) {
                    const reachedFinishZone =
                        isAtRlglFinish(
                            payload.position
                        );

                    if (
                        !reachedFinishZone &&
                        !isInsideRlglArena(
                            payload.position
                        )
                    ) {
                        eliminateRlglPlayer(
                            io,
                            socket,
                            "out_of_bounds"
                        );
                        socket.data.lastMoveAt = now;
                        socket.emit("rlgl:correction", player.position);
                        return;
                    }

                    if (rlglState.isRedLight && socket.data.rlglRedAnchor) {
                        const moveDist = horizontalDistance(socket.data.rlglRedAnchor, payload.position);
                        if (moveDist > RLGL_RED_MOVEMENT_TOLERANCE) {
                            eliminateRlglPlayer(io, socket, "moved_on_red");
                            socket.data.lastMoveAt = now;
                            socket.emit("rlgl:correction", player.position);
                            return;
                        }
                    }
                }
            } else {
                const allowedDistance = MAX_SPEED_UNITS_PER_SECOND * elapsedSeconds + MOVEMENT_TOLERANCE;
                if (distance(player.position, payload.position) > allowedDistance) return;
            }

            player.position = { ...payload.position };
            player.rotation = { ...payload.rotation };
            socket.data.lastMoveAt = now;
            broadcastPlayerPosition(io, player);

            if (socket.data.inCarRace) {
                checkCarRaceProgress(
                    io,
                    socket,
                    player
                );
            }

            if (
                !socket.data.inRlgl &&
                !socket.data.inCampusQuiz &&
                !socket.data.inCarRace
            ) {
                void checkCampusExplorationProgress(io, socket, player).then(({ completedNow } = {}) => {
                    if (completedNow) scheduleDynamicMission(io, socket, player, { minDelayMs: 8_000, maxDelayMs: 15_000 });
                }).catch((error) => console.error("Campus exploration check failed:", error.message));
                void checkDynamicMissionProgress(io, socket, player);
            }
        });

        socket.on("player:animation", (animation) => {
            const player = players.get(socket.id);
            if (!player || !VALID_ANIMATIONS.has(animation) || player.animation === animation) return;
            player.animation = animation;
            io.emit("player:animationChanged", { socketId: socket.id, animation });
        });

        socket.on("player:identityUpdate", async () => {
            const player = players.get(socket.id);
            if (!player || player.accountType !== "guest" || !player.guestId) return;
            try {
                const profile = await getConvertedUserForGuest(player.guestId);
                if (!profile) return;
                const previousQuizGuestId = player.guestId;

                player.accountType = "user";
                player.userId = profile.userId;
                player.guestId = null;
                player.guestCode = null;

                if (Number.isSafeInteger(previousQuizGuestId)) {
                    try {
                        await transferCampusQuizGuestProgress(
                            previousQuizGuestId,
                            profile.userId,
                            profile.playerName
                        );
                    } catch (error) {
                        console.error(
                            "Could not transfer Campus Quiz progress:",
                            error.message
                        );
                    }
                }
                player.playerName = profile.playerName.slice(0, MAX_PLAYER_NAME_LENGTH);
                io.emit("player:identityChanged", {
                    socketId: socket.id,
                    accountType: player.accountType,
                    playerName: player.playerName
                });
                void broadcastLeaderboard(io);
            } catch (error) {
                console.error("Could not update multiplayer identity:", error.message);
            }
        });

        socket.on("player:profileUpdate", async () => {
            const player = players.get(socket.id);
            const guestSession = socket.request.session;
            if (!player || player.accountType !== "guest"
                || guestSession?.accountType !== "guest"
                || guestSession.guestId !== player.guestId) return;
            try {
                const guest = await findGuestById(player.guestId);
                if (!guest || guest.convertedToUserId) return;
                player.playerName = guest.playerName.slice(0, MAX_PLAYER_NAME_LENGTH);
                player.avatarKey = guest.avatarKey;
                io.emit("player:profileUpdated", {
                    socketId: socket.id,
                    playerName: player.playerName,
                    avatarKey: player.avatarKey
                });
                void broadcastLeaderboard(io);
            } catch (error) {
                console.error("Could not update multiplayer profile:", error.message);
            }
        });

        socket.on("chat:message", (payload = {}) => {
            const player = players.get(socket.id);
            const text = typeof payload.text === "string" ? payload.text.trim().slice(0, 160) : "";
            if (!player || !text) return;
            const message = {
                id: `${Date.now()}-${socket.id}`,
                sender: player.playerName,
                text,
                timestamp: Date.now()
            };
            chatHistory.push(message);
            if (chatHistory.length > MAX_CHAT_HISTORY) chatHistory.shift();
            io.emit("chat:message", message);
        });

        socket.on("rlgl:join", async () => {
            const player = players.get(socket.id);
            if (!player) {
                socket.emit("rlgl:error", "Join multiplayer before entering the minigame.");
                return;
            }

            if (socket.data.inCampusQuiz) {
                socket.emit("rlgl:error", "Exit Campus Quiz before entering Red Light, Green Light.");
                return;
            }

            if (socket.data.inCarRace) {
                socket.emit("rlgl:error", "Exit the Campus Road Race before entering Red Light, Green Light.");
                return;
            }

            cancelDynamicMissionForMinigame(
                socket
            );

            if (!socket.data.inRlgl) {
                await socket.join(RLGL_ROOM);
                socket.data.inRlgl = true;
                resetRlglSocketState(socket);
                const waitingIndex = Math.max(0, getRlglSockets(io).findIndex((roomSocket) => roomSocket.id === socket.id));
                teleportRlglPlayer(
                    io,
                    socket,
                    getRlglSpawn(
                        waitingIndex,
                        RLGL_WAITING_SPAWN.x
                    ),
                    "join"
                );
            }

            if (rlglState.phase === "IDLE") {
                startRlglLobby(io);
                return;
            }

            if (rlglState.phase === "ACTIVE") {
                socket.data.isPlaying = false;
                socket.emit("rlgl:role", "spectator");
            } else {
                socket.emit("rlgl:role", rlglState.phase === "LOBBY" ? "waiting" : "spectator");
            }
            socket.emit("rlgl:phase", rlglState.phase);
            if (rlglState.phase === "ACTIVE") {
                socket.emit("rlgl:state", rlglState.isRedLight);
                socket.emit("rlgl:round_started", {
                    roundId: rlglState.roundId,
                    endsAt: rlglState.roundEndsAt
                });
            }
        });

        socket.on("rlgl:finish", async () => {
            const player = players.get(socket.id);
            if (!player
                || !socket.data.inRlgl
                || rlglState.phase !== "ACTIVE"
                || !socket.data.isPlaying
                || socket.data.isEliminated
                || socket.data.hasFinished
                || !isAtRlglFinish(player.position)) return;

            socket.data.hasFinished = true;
            socket.data.rlglRedAnchor = null;

            let rewardSaved = false;
            let totalPoints = null;
            try {
                const account = player.accountType === "user"
                    ? await addUserPoints(player.userId, RLGL_REWARD_POINTS)
                    : await addGuestPoints(player.guestCode, RLGL_REWARD_POINTS);
                rewardSaved = Boolean(account);
                totalPoints = account?.points ?? null;
            } catch (error) {
                console.error("Failed to save RLGL reward:", error.message);
            }

            socket.emit("rlgl:winner", {
                pointsEarned: rewardSaved ? RLGL_REWARD_POINTS : 0,
                rewardSaved,
                totalPoints
            });
            if (rewardSaved) void broadcastLeaderboard(io);

            const announcement = rewardSaved
                ? `${player.playerName} survived and earned ${RLGL_REWARD_POINTS} points!`
                : `${player.playerName} survived! Their reward could not be saved.`;
            io.to(RLGL_ROOM).emit("chat:message", {
                id: `${Date.now()}-server`,
                sender: "SERVER",
                text: announcement,
                timestamp: Date.now()
            });

            checkRlglRoundStatus(io);
        });

        socket.on("rlgl:leave", async () => {
            if (!socket.data.inRlgl) return;

            const wasActivePlayer = rlglState.phase === "ACTIVE"
                && socket.data.isPlaying
                && !socket.data.isEliminated
                && !socket.data.hasFinished;

            socket.data.inRlgl = false;
            resetRlglSocketState(socket);
            await socket.leave(RLGL_ROOM);

            const player = players.get(socket.id);
            if (player) {
                const campusReturn = { x: -10, y: 10, z: 15 };
                player.position = campusReturn;
                socket.data.lastMoveAt = Date.now();
                socket.emit("rlgl:teleport", { position: campusReturn, reason: "leave" });
                broadcastPlayerPosition(io, player);
            }
            socket.emit("rlgl:left");

            if (player) {
                resumeDynamicMissionsAfterMinigame(
                    io,
                    socket,
                    player
                );
            }

            if (wasActivePlayer) checkRlglRoundStatus(io);
            ensureRlglStopsWhenEmpty(io);
        });

        socket.on("disconnect", () => {
            stopDynamicMissions(
                socket
            );

            if (socket.data.sessionValidationTimer) clearInterval(socket.data.sessionValidationTimer);
            const wasInRlgl = Boolean(socket.data.inRlgl);
            const wasActivePlayer = wasInRlgl
                && rlglState.phase === "ACTIVE"
                && socket.data.isPlaying
                && !socket.data.isEliminated
                && !socket.data.hasFinished;

            if (players.delete(socket.id)) io.emit("player:left", socket.id);
            if (socket.data.accountKey
                && activePlayerSockets.get(socket.data.accountKey) === socket.id) {
                activePlayerSockets.delete(socket.data.accountKey);
                if (socket.data.authUserId && socket.data.authSessionId) {
                    // A refresh restores /api/profile immediately and renews
                    // this lease. A genuinely closed tab leaves it to expire,
                    // allowing another browser to log in shortly afterward.
                    void setActiveSessionExpiration(
                        socket.data.authUserId,
                        socket.data.authSessionId,
                        new Date(Date.now() + 3000)
                    ).catch((error) => {
                        console.error("Could not shorten closed game session:", error.message);
                    });
                }
            }

            if (wasActivePlayer) checkRlglRoundStatus(io);
            if (wasInRlgl) ensureRlglStopsWhenEmpty(io);
        });
    });
}

export { players };

export function disconnectUserSession(userId, sessionId) {
    if (!multiplayerIo) return;
    for (const socket of multiplayerIo.sockets.sockets.values()) {
        if (socket.data.authUserId !== userId || socket.data.authSessionId !== sessionId) continue;
        socket.disconnect(true);
    }
}
